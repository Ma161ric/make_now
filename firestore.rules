rules_version = '2';

// Each user reads and writes only their own data. Everything not listed here is
// denied, including the server-only collections (calendar_connections with the
// Google tokens, dayflow_blocks, ai_usage, time_log writes).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // no huge documents: keeps a single account from filling the database
    function smallDoc() {
      return request.resource.data.size() <= 60;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /items/{taskId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && smallDoc()
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.status in ['open', 'scheduled', 'in_progress', 'done', 'cancelled'];
      }

      match /day_plans/{planId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && smallDoc();
      }

      match /daily_reviews/{reviewId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && smallDoc();
      }

      match /inbox_notes/{noteId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && smallDoc()
          && request.resource.data.raw_text is string
          && request.resource.data.raw_text.size() <= 4000;
      }

      match /extractions/{extractionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && smallDoc();
      }

      // written by the server only (learning data); you may look at it
      match /time_log/{entryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
