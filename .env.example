# Firebase Configuration
# Get these from Firebase Console: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional: Firebase App Check (see docs/SECURITY.md). The site key is public, not a secret.
# VITE_APPCHECK_SITE_KEY=
# Server: '1' = API accepts only requests with a valid App Check token. Set only after the
# key has been live for a few days and the Firebase console shows (almost) only verified requests.
# APPCHECK_ENFORCE=1

# Groq API Configuration
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# Claude (main model, paid, only used for signed-in users; Groq is the fallback)
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key
# Optional overrides
# ANTHROPIC_MODEL=claude-haiku-5-5
# GROQ_MODEL=openai/gpt-oss-120b
# Speech to text (Whisper on Groq)
# GROQ_STT_MODEL=whisper-large-v3-turbo
# Max chat requests per user and day (cost protection)
# CHAT_DAILY_LIMIT=150
# EXTRACT_DAILY_LIMIT=100
# TRANSCRIBE_DAILY_LIMIT=60

# Optional: Set to 'production' for production builds
VITE_ENV=development

# --- Google Calendar (server only, never prefix with VITE_) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must be listed as "Authorized redirect URI" in the OAuth client
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/calendar/callback
# Where the callback sends the browser back to (no trailing slash)
APP_URL=https://your-app.vercel.app
# Firebase Console -> Project settings -> Service accounts -> Generate new private key (paste JSON in one line)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Random strings, e.g. `openssl rand -hex 32`
OAUTH_STATE_SECRET=change-me
# Protects /api/cron/plan-tomorrow (Vercel Cron sends it). Reminders (/api/cron/remind) also
# accept the OIDC token of .github/workflows/remind.yml, so no secret is needed in GitHub.
CRON_SECRET=change-me

# Optional: API base for the app (default: same origin, /api)
# VITE_API_URL=
