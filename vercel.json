{
  "buildCommand": null,
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/feed/:token",
      "destination": "/api/calendar?action=feed&t=:token"
    },
    {
      "source": "/api/calendar/:action",
      "destination": "/api/calendar?action=:action"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/plan-tomorrow",
      "schedule": "0 19 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
