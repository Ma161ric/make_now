{
  "buildCommand": null,
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/calendar/:action",
      "destination": "/api/calendar?action=:action"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/plan-tomorrow",
      "schedule": "0 19 * * *"
    }
  ]
}
